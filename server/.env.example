PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/portfolio
# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
# Allowed browser origins (comma separated). Used in dev when the client runs on Vite.
CLIENT_URL=http://localhost:5173
# Created on first boot only. Change the password from Admin → Account afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Now-123!
